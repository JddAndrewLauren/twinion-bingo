{
  "name": "twinion-bingo",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "pool:build": "pnpm --filter @twinion-bingo/theme run pool:build",
    "db:workspace": "pnpm --filter @twinion-bingo/api db:workspace",
    "sim": "pnpm --filter @twinion-bingo/api sim",
    "test": "pnpm -r test"
  }
}
