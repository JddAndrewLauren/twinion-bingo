# The API image is built with the repo root as context, so keep the upload small.
.git
node_modules
**/node_modules
**/.next
**/dist
**/*.tsbuildinfo
# These patterns are anchored at the build-context root, so they cover /.env
# only. Every Conductor workspace now has an apps/api/.env with a live
# connection string, and `COPY apps/api apps/api` would carry it into the build
# stage — hence the `**/` forms.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
