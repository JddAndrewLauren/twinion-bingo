# Comma-separated origins the web app is served from — the only origins allowed to
# call this API. Vercel previews of a listed *.vercel.app project are allowed too.
# Required in production; the API refuses to start without it.
WEB_ORIGIN=http://localhost:3000

# Port the API listens on. Fly sets this via fly.toml [env].
PORT=8080

# Postgres connection string. Required — every room read and write goes to it, so
# the API refuses to start without one rather than guessing a default. The bingo
# tables live in their own `bingo` schema
# of a database shared with the twinion project (D3), so never run drizzle-kit
# push/pull against it — `pnpm --filter @twinion-bingo/api db:migrate` is the
# only supported way to change it. For local work, run `pnpm db:workspace` — it
# brings up the local container and rewrites this line to point at this
# workspace's own database, never at the shared project.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres

# Connection string for the DB-backed tests, which TRUNCATE every bingo table on
# entry. Deliberately a different variable from DATABASE_URL and deliberately
# left commented out here: a live value in the file everyone copies would arm
# that truncate for whoever copied it. Unset, those suites skip.
#
# `pnpm db:workspace` fills it in inside a Conductor workspace, pointing it at
# that workspace's own database (`bingo_<workspace-dir>`). The tests refuse any
# non-local host, and refuse any database that is not this workspace's own — see
# docs/adr/0005-a-database-per-conductor-workspace.md.
#
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/bingo_<workspace>
