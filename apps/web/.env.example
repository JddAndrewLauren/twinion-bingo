# Base URL of the bingo API. Read in the browser, so it must be NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical origin every Room URL is built from — the share link, the canonical
# tag, `metadataBase` and the unfurl. Server-only on purpose: deliberately NOT
# NEXT_PUBLIC_, so no client bundle can depend on it. Set in Vercel's Production
# environment only; leave it unset here and in preview, where the host the
# request arrived on is the right answer.
# SITE_URL=https://bingo.twinion.net
